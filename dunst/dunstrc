[global]
    follow = none
    width = 320
    height = (0, 160)
    origin = top-right
    # On Wayland, this offset starts below Waybar's exclusive zone.
    offset = (8, 8)
    notification_limit = 4
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    gap_size = 8
    padding = 12
    horizontal_padding = 16
    frame_width = 1
    separator_color = frame
    progress_bar = false
    sort = yes
    idle_threshold = 0

    font = VictorMono Nerd Font Mono 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    word_wrap = yes
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = no
    icon_position = off
    history_length = 20

    dmenu = /usr/bin/wofi --dmenu --prompt "选择操作"
    browser = /usr/bin/firefox -new-tab
    always_run_script = false
    title = Dunst
    class = Dunst
    corner_radius = 5
    ignore_dbusclose = false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = do_action

[urgency_low]
    background = "#151515f2"
    foreground = "#d0d0d0"
    frame_color = "#3a3a3a"
    timeout = 4
    script = "/home/xiaou0/.config/dunst/notify-sound.sh"

[urgency_normal]
    background = "#151515f2"
    foreground = "#d0d0d0"
    frame_color = "#3a3a3a"
    timeout = 5
    script = "/home/xiaou0/.config/dunst/notify-sound.sh"

[urgency_critical]
    background = "#151515f2"
    foreground = "#d0d0d0"
    frame_color = "#ff4444"
    format = "<span foreground='#ff4444'><b>!</b></span> <b>%s</b>\n%b"
    timeout = 0
    script = "/home/xiaou0/.config/dunst/notify-sound.sh"
