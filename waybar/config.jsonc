{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "margin-top": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/updates",
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],
  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi -n --show drun"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "rewrite": {
      "": ""
    },
    "separate-outputs": true,
    "max-length": 24,
    "tooltip": false
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%a · %m/%d}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage:>2}%",
    "tooltip": true,
    "tooltip-format": "CPU · {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage:>2}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },
  "custom/updates": {
    "exec": "bash ~/.config/waybar/scripts/pacman-update-icon.sh",
    "interval": 1800,
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰌷",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "iwgtk"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth": " {volume}%",
    "format-bluetooth-muted": " 󰖁",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip": true,
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}%"
  },
  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 100%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}  {power:.1f} W"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
