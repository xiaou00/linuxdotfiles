{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 7,
  "margin-right": 7,
  "margin-bottom": 1,
  "margin-left": 7,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi -n --show drun"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "hyprland/window": {
    "format": "  {title}",
    "rewrite": {
      "": "  --"
    },
    "separate-outputs": true,
    "max-length": 52,
    "tooltip": false
  },

  "clock": {
    "interval": 1,
    "format": "  {:%H:%M:%S  %Y-%m-%d}",
    "format-alt": "  {:%A  %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "cpu": {
    "interval": 2,
    "format": "CPU  {usage:>2}%",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "MEM  {percentage:>2}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "network": {
    "interval": 3,
    "format-wifi": "NET  {signalStrength:>3}%",
    "format-ethernet": "NET  LAN",
    "format-linked": "NET  LINK",
    "format-disconnected": "NET  DOWN",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "iwgtk"
  },

  "pulseaudio": {
    "format": "VOL  {volume:>3}%",
    "format-muted": "VOL  MUT",
    "format-bluetooth": "BT   {volume:>3}%",
    "format-bluetooth-muted": "BT   MUT",
    "format-icons": {
      "default": ["", "", ""]
    },
    "tooltip": false,
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    "interval": 10,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "PWR  {capacity:>3}%",
    "format-charging": "CHG  {capacity:>3}%",
    "format-plugged": "PWR  AC",
    "format-full": "PWR  100%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}  {power:.1f} W"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 6
  }
}
