# --- Colors (obsidian-ember) ---
set default-bg         "#151515"
set default-fg         "#d0d0d0"

set statusbar-bg       "#1b1b1b"
set statusbar-fg       "#d0d0d0"

set inputbar-bg        "#242424"
set inputbar-fg        "#d0d0d0"

set notification-bg    "#242424"
set notification-fg    "#d0d0d0"
set notification-error-bg   "#ff4444"
set notification-error-fg   "#151515"
set notification-warning-bg "#ffcc00"
set notification-warning-fg "#151515"

set highlight-color         "#ff444444"
set highlight-active-color  "#ff4444aa"

set completion-bg      "#1b1b1b"
set completion-fg      "#d0d0d0"
set completion-highlight-bg "#ff4444"
set completion-highlight-fg "#151515"

set recolor true
set recolor-lightcolor "#151515"
set recolor-darkcolor  "#d0d0d0"

# --- Behavior ---
set scroll-step           50
set zoom-step             10
set adjust-open           "best-fit"
set database              sqlite
set continuous-hist-save  true
set filemonitor           signal
set open-first-page       false
set statusbar-home-tilde  true
set window-title-basename true
set selection-clipboard   clipboard
set render-loading        true
set guioptions            ""
